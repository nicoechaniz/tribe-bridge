# Public, signed identity inputs
TRIBE_V1_DIRECTORY=/home/agent/.tribe-bridge/v1/directory.json
TRIBE_V1_GOVERNANCE_ROOTS=/home/agent/.tribe-bridge/v1/governance-roots.json
TRIBE_V1_DIRECTORY_STATE=/home/agent/.tribe-bridge/v1/directory-state.json

# Private purpose-separated Ed25519/X25519 bundle (mode 0600)
TRIBE_V1_KEYS=/home/agent/.tribe-bridge/v1/agent.keys.json

# Broker service
TRIBE_V1_DB=/home/agent/.tribe-bridge/v1/broker.sqlite
TRIBE_V1_BIND=127.0.0.1
TRIBE_V1_PORT=8685
TRIBE_V1_MAX_WORKERS=16
TRIBE_V1_JOURNAL_MODE=auto
TRIBE_V1_BUILD_COMMIT=0000000000000000000000000000000000000000

# Client routes: direct is attempted before hub with the same envelope/ID.
TRIBE_V1_ROUTES={"codex@localhost":{"direct":"http://127.0.0.1:8685","hub":"https://hub.example.invalid"},"public-agents":{"hub":"https://hub.example.invalid"}}
TRIBE_V1_INBOX_ENDPOINTS=["http://127.0.0.1:8685","https://hub.example.invalid"]
TRIBE_V1_CLIENT_DB=/home/agent/.tribe-bridge/v1/client.sqlite
TRIBE_V1_CLIENT_INBOX_DB=/home/agent/.tribe-bridge/v1/inbox.sqlite

# Hermes integration
TRIBE_V1_REPO=/home/agent/Projects/tribe-bridge
TRIBE_V1_PYTHON=/home/agent/.tribe-bridge/v1/venv/bin/python

# Mirror: all three allowlists are mandatory and non-empty.
TRIBE_V1_MIRROR_DB=/home/agent/.tribe-bridge/v1/mirror.sqlite
TRIBE_V1_MIRROR_AUDIENCES=["public-agents"]
TRIBE_TELEGRAM_ALLOWED_CHAT_IDS=[-1000000000000]
TRIBE_TELEGRAM_ALLOWED_USER_IDS=[123456789]
TRIBE_TELEGRAM_CHAT_ID=-1000000000000
TRIBE_TELEGRAM_BOT_TOKEN=replace-at-deploy-time
