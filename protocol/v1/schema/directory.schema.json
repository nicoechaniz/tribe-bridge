{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tribe.invalid/protocol/v1/directory.schema.json",
  "title": "Tribe v1 signed identity and authorization directory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "directory_epoch",
    "issued_at_ms",
    "expires_at_ms",
    "previous_sha256",
    "agents",
    "audiences",
    "governance"
  ],
  "properties": {
    "schema": {"const": "tribe-directory/v1"},
    "directory_epoch": {"type": "integer", "minimum": 1},
    "issued_at_ms": {"type": "integer", "minimum": 0},
    "expires_at_ms": {"type": "integer", "minimum": 1},
    "previous_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      ]
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "signing_keys", "encryption_keys"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "status": {"enum": ["active", "suspended", "retired"]},
          "signing_keys": {
            "type": "array",
            "items": {"$ref": "#/$defs/key"}
          },
          "encryption_keys": {
            "type": "array",
            "items": {"$ref": "#/$defs/key"}
          }
        }
      }
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"required": ["observers"]},
            "then": {"properties": {"type": {"const": "direct"}}}
          },
          {
            "if": {"required": ["legacy_unobserved_receive"]},
            "then": {
              "required": ["observers"],
              "properties": {
                "type": {"const": "direct"},
                "status": {"const": "retired"}
              }
            }
          }
        ],
        "required": [
          "type",
          "id",
          "epoch",
          "status",
          "members",
          "allowed_senders"
        ],
        "properties": {
          "type": {"enum": ["direct", "group"]},
          "id": {"$ref": "#/$defs/identifier"},
          "epoch": {"type": "integer", "minimum": 1},
          "status": {"enum": ["active", "retired", "revoked"]},
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "observers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 255,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "legacy_unobserved_receive": {"const": true},
          "allowed_senders": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {"$ref": "#/$defs/identifier"}
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "signatures"],
      "properties": {
        "threshold": {"type": "integer", "minimum": 1},
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/signature"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._@/-]{0,126}[a-z0-9])?$"
    },
    "base64url": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kid",
        "epoch",
        "public_key",
        "status",
        "not_before_ms",
        "not_after_ms"
      ],
      "properties": {
        "kid": {"$ref": "#/$defs/identifier"},
        "epoch": {"type": "integer", "minimum": 1},
        "public_key": {"$ref": "#/$defs/base64url"},
        "status": {
          "enum": ["active", "retired", "revoked", "compromised"]
        },
        "not_before_ms": {"type": "integer", "minimum": 0},
        "not_after_ms": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1}
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kid", "alg", "value"],
      "properties": {
        "kid": {"$ref": "#/$defs/identifier"},
        "alg": {"const": "Ed25519"},
        "value": {"$ref": "#/$defs/base64url"}
      }
    }
  }
}
