#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: tribe <command> [arguments]

Commands:
  send          Send a private or explicit-group message
  inbox         Claim, decrypt, deduplicate, and ACK messages
  flush-outbox  Retry durably staged messages
  help          Show this help

Set TRIBE_CLIENT_ENV to select a client identity, or install an explicit host
default at $HOME/.config/tribe/client.env.
EOF
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
    shift
fi

case "$command_name" in
    help|-h|--help)
        usage
        exit 0
        ;;
    send|inbox|flush-outbox)
        ;;
    *)
        printf 'tribe: unknown command: %s\n' "$command_name" >&2
        usage >&2
        exit 2
        ;;
esac

client_env="${TRIBE_CLIENT_ENV:-$HOME/.config/tribe/client.env}"
if [[ ! -r "$client_env" ]]; then
    printf 'tribe: client environment is not readable: %s\n' "$client_env" >&2
    exit 2
fi

set -a
# shellcheck disable=SC1090
source "$client_env"
set +a

repo="${TRIBE_V1_REPO:-$HOME/Projects/tribe-bridge}"
python="${TRIBE_V1_PYTHON:-$HOME/.tribe-bridge/v1/venv/bin/python}"

case "$command_name" in
    send)
        exec "$python" "$repo/scripts/send_v1.py" "$@"
        ;;
    inbox)
        exec "$python" "$repo/scripts/check_inbox_v1.py" "$@"
        ;;
    flush-outbox)
        exec "$python" "$repo/scripts/flush_outbox_v1.py" "$@"
        ;;
esac
