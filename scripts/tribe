#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: tribe <command> [arguments]

Commands:
  send          Send a private or explicit-group message
  inbox         Claim, decrypt, deduplicate, and ACK messages
  flush-outbox  Retry durably staged messages
  help          Show this help

Set TRIBE_CLIENT_ENV explicitly to select a client identity. The harness owns
that choice; this command never chooses a default principal.
EOF
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
    shift
fi

case "$command_name" in
    help|-h|--help)
        usage
        exit 0
        ;;
    send|inbox|flush-outbox)
        ;;
    *)
        printf 'tribe: unknown command: %s\n' "$command_name" >&2
        usage >&2
        exit 2
        ;;
esac

client_env="${TRIBE_CLIENT_ENV:-}"
if [[ -z "$client_env" ]]; then
    printf 'tribe: TRIBE_CLIENT_ENV is required\n' >&2
    exit 2
fi
# Freeze executable selection before loading identity material. The Python
# launcher parses a closed data format; client files are never sourced as shell.
repo="${TRIBE_V1_REPO:-$HOME/Projects/tribe-bridge}"
python="${TRIBE_V1_PYTHON:-$HOME/.tribe-bridge/v1/venv/bin/python}"
exec "$python" "$repo/scripts/tribe_launcher.py" \
    --repo "$repo" \
    --python "$python" \
    --client-env "$client_env" \
    --command "$command_name" \
    -- "$@"
