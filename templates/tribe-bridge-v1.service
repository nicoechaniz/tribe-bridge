[Unit]
Description=Tribe Bridge v1 durable broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.tribe-bridge/v1/service.env
WorkingDirectory=%h/Projects/tribe-bridge
ExecStart=/usr/bin/env %h/.tribe-bridge/v1/venv/bin/python %h/Projects/tribe-bridge/src/tribe_service_v1.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.tribe-bridge/v1
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
